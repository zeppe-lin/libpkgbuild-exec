option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'Select the dependency linkage mode',
)
option(
  'tests',
  type: 'feature',
  value: 'disabled',
  description: 'Build the adapter contract tests',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Build and install manual pages with scdoc',
)
